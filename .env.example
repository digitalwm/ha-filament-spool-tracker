# SpoolTracker standalone Docker (docker-compose.standalone.yml)
# Copy to .env and fill in your values:
#   cp .env.example .env

# Optional direct Bambu LAN connection. Set all four values to use printer-native telemetry.
# Keep the access code private; it grants local printer access.
# BAMBU_PRINTER_HOST=192.168.1.50
# BAMBU_PRINTER_SERIAL=printer-serial-number
# BAMBU_PRINTER_ACCESS_CODE=printer-access-code
# BAMBU_PRINTER_ID=registered-SpoolTracker-printer-id

# Optional (defaults shown)
PORT=3000
# Host path for DB and cache (default: ./data so app.db lives outside the container)
# DATA_PATH=./data
# DATABASE_URL=file:/data/app.db
# LOG_LEVEL=info
